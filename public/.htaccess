# Enrutado del front controller para Apache.
#
# En desarrollo se usa `php -S ... public/index.php`, que enruta por el script
# y hace innecesario este fichero. En producción manda Apache, así que sin esto
# cualquier ruta que no sea un fichero real devuelve 404.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Los ficheros y directorios que existen se sirven tal cual (assets).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Apache no conoce .webmanifest de serie y lo serviría como texto plano.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# El service worker NO es un fichero estático: lo sirve PHP desde /sw.js para
# inyectarle la versión de la caché, y de ahí salen también sus cabeceras.
# Ver src/Support/AssetVersion.php.

# Los ficheros ocultos no se sirven nunca.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
