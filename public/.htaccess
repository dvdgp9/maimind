# Enrutado del front controller para Apache.
#
# En desarrollo se usa `php -S ... public/index.php`, que enruta por el script
# y hace innecesario este fichero. En producción manda Apache, así que sin esto
# cualquier ruta que no sea un fichero real devuelve 404.

Options -Indexes -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Los ficheros y directorios que existen se sirven tal cual (assets).
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [L]
</IfModule>

# Apache no conoce .webmanifest de serie y lo serviría como texto plano.
<IfModule mod_mime.c>
    AddType application/manifest+json .webmanifest
</IfModule>

# El service worker no se cachea. Si se cacheara, una versión nueva podría
# tardar hasta un día en llegar al teléfono de alguien, y con ella todos los
# assets que ese worker decide servir desde su propia caché.
<Files "sw.js">
    <IfModule mod_headers.c>
        Header set Cache-Control "no-cache, max-age=0"
    </IfModule>
</Files>

# Los ficheros ocultos no se sirven nunca.
<FilesMatch "^\.">
    Require all denied
</FilesMatch>
