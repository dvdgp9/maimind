#!/usr/bin/env bash
#
# Despliegue en producción. Se ejecuta EN el servidor:
#
#   sudo bash /home/dvdgp/web/maimind.iaiapro.com/public_html/bin/deploy
#
# Idempotente: se puede lanzar tantas veces como haga falta.

set -euo pipefail

APP="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OWNER=dvdgp
WEBGROUP=www-data

cd "$APP"

echo "==> Código"
git config --global --add safe.directory "$APP" 2>/dev/null || true
git pull --ff-only origin main
echo "    $(git rev-parse --short HEAD) $(git log -1 --format=%s)"

echo "==> Dependencias"
COMPOSER_ALLOW_SUPERUSER=1 composer install --no-dev --no-interaction --optimize-autoloader --quiet

echo "==> Migraciones"
php bin/migrate

echo "==> Catálogo"
php bin/seed

echo "==> Permisos"
# El código lo lee el servidor web; storage además lo escribe.
chown -R "$OWNER:$OWNER" "$APP"
chgrp -R "$WEBGROUP" "$APP/storage"
chmod -R 2770 "$APP/storage"
chmod 600 "$APP/.env"

echo "==> Worker"
# Rearranque, no recarga: el worker lleva el código en memoria y sin reiniciarlo
# seguiría ejecutando la versión anterior. Si la unidad no está instalada aún,
# no es un error: se instala una vez, a mano (ver docs/despliegue.md).
if systemctl list-unit-files maimind-worker.service >/dev/null 2>&1 \
   && systemctl is-enabled maimind-worker >/dev/null 2>&1; then
  systemctl restart maimind-worker
  echo "    reiniciado"
else
  echo "    unidad no instalada — ver docs/despliegue.md"
fi

echo "==> Comprobación"
php bin/check

echo "==> Listo"
