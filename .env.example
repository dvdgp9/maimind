# Copiar a .env y rellenar. El .env NUNCA se sube al repositorio.

APP_NAME=MaiMind
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_KEY=

# Idioma
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# Todo se almacena en UTC. Esta zona es solo para presentación por defecto.
APP_TIMEZONE=UTC

# Base de datos — MariaDB
# Producción corre 11.4.10. En local vale el MariaDB que ya tengas: bin/check avisa
# si la versión mayor.menor no coincide con la de producción.
# Para paridad exacta: docker compose up -d db  (expone el 3307)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maimind
DB_USERNAME=maimind
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# OpenRouter — transcripción y extracción
# Ver docs/api/openrouter.md
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TRANSCRIPTION_MODEL=openai/whisper-1
OPENROUTER_EXTRACTION_MODEL=
OPENROUTER_TRANSCRIPTION_TIMEOUT=120
OPENROUTER_EXTRACTION_TIMEOUT=180

# Retención de audio en días. 0 = borrar en cuanto se transcriba.
AUDIO_RETENTION_DAYS=30

# Worker
WORKER_SLEEP_SECONDS=5
WORKER_MAX_JOBS_PER_RUN=50

LOG_LEVEL=debug
