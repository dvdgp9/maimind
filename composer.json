{
    "name": "dvdgp/maimind",
    "description": "Plataforma de autoobservación y análisis longitudinal",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.3",
        "ext-curl": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "psr/log": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "MaiMind\\": "src/"
        },
        "files": [
            "src/Support/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "MaiMind\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.3.30"
        }
    },
    "scripts": {
        "check": "php bin/check",
        "test": [
            "@test:php",
            "@test:js"
        ],
        "test:php": "phpunit",
        "test:js": "node --test tests/js/*.test.mjs",
        "icons": "php bin/icons"
    }
}
